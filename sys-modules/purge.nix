# Self-contained purge package: embeds all .rs sources + Cargo.toml/Cargo.lock,
# builds with rustPlatform.buildRustPackage (pinned cargo lock), and wraps only
# `npm` (nodejs) into PATH -- every other binary purge execs already ships on a
# stock NixOS (coreutils, findutils, util-linux, systemd, nix, sudo).
{
  lib,
  rustPlatform,
  stdenv,
  makeWrapper,
  nodejs,
}:

let
  cargoToml = builtins.toFile "Cargo.toml" ''
    [package]
    name = "purge"
    version = "0.1.0"
    edition = "2021"
    description = "Catppuccin-themed RAM and storage cleaning TUI for NixOS"

    [dependencies]
    ratatui = "0.29"
    crossterm = "0.28"

    [profile.release]
    lto = true
    strip = true
  '';
  cargoLock = builtins.toFile "Cargo.lock" ''
