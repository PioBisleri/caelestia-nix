            Paragraph::new(Line::from(Span::styled(info, theme::subtle()))),
            inner[4],
        );

        // buff/cache breakdown
        let detail = format!(
            "buffers {}   cached {}   slab_reclaimable {}",
            display_bytes(m.buffers_kb * 1024),
            display_bytes(m.cached_kb * 1024),
            display_bytes(m.sreclaimable_kb * 1024),
        );
        f.render_widget(
            Paragraph::new(Line::from(Span::styled(detail, theme::text())))
                .block(Block::default().borders(Borders::ALL).title("Detail")),
