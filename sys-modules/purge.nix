                    Cell::from(format!("{:.1}%", p.cpu_pct)).style(cpu_style(p.cpu_pct)),
                    Cell::from(p.cmd.as_str()).style(Style::default().fg(theme::SUBTLE)),
                ])
                .style(style)
            })
            .collect();

        let base = if app.by_cpu {
