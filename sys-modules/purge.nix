  uiRs = builtins.toFile "ui.rs" ''
    use ratatui::{
        layout::{Constraint, Layout, Rect},
        style::{Modifier, Style},
        text::{Line, Span},
        widgets::{Block, Borders, Cell, Clear, Gauge, Paragraph, Row, Sparkline, Table},
        Frame,
    };

    use crate::app::{display_bytes, App, InputMode, Tab, SPINNER};
    use crate::runner::LogLevel;
    use crate::storage::ScanState;
    use crate::theme;

    fn header(f: &mut Frame, app: &App) {
        let area = f.area();
        let chunk = Layout::vertical([
            Constraint::Length(3),
            Constraint::Length(1),
            Constraint::Min(0),
            Constraint::Length(3),
        ])
        .split(area);

        let tabs: Vec<Line> = crate::app::tab_list()
            .iter()
            .map(|t| {
                let name = t.name();
                if *t == app.tab {
                    Line::from(vec![
                        Span::styled("◆ ", theme::accent()),
                        Span::styled(name, theme::accent_bold()),
                    ])
                } else {
                    Line::from(vec![
                        Span::styled("◇ ", theme::subtle()),
                        Span::styled(name, theme::text()),
                    ])
                }
            })
            .collect();
        let title = Paragraph::new(tabs)
            .block(Block::default().borders(Borders::ALL).border_style(theme::subtle()))
            .style(theme::text());
        f.render_widget(title, chunk[0]);

        // status line
        let mem = &app.mem;
        let mut status = format!(
            "RAM {} / {}   Swap {} / {}   Reclaimable {}",
            display_bytes(mem.used_kb() * 1024),
            display_bytes(mem.total_kb * 1024),
            display_bytes(mem.swap_used_kb() * 1024),
            display_bytes(mem.swap_total_kb * 1024),
            display_bytes(mem.reclaimable_kb() * 1024),
        );
        if app.scanning {
            status.push_str(&format!("   {} scanning", SPINNER[app.spinner]));
        }
        if app.cleaning {
            status.push_str(&format!("   {} cleaning", SPINNER[app.spinner]));
        }
        f.render_widget(
            Paragraph::new(Line::from(Span::styled(status, theme::subtle())))
                .style(theme::text()),
            chunk[1],
        );

        // body
        match app.tab {
            Tab::Storage => draw_storage(f, app, chunk[2]),
            Tab::Memory => draw_memory(f, app, chunk[2]),
            Tab::Processes => draw_processes(f, app, chunk[2]),
            Tab::Limiter => draw_limiter(f, app, chunk[2]),
            Tab::Logs => draw_logs(f, app, chunk[2]),
        }

        // footer hints
        let hint = match app.tab {
            Tab::Storage => {
                "s scan  space select  a/n all/none  c clean (confirms)  ↑/↓ move  ? help  q quit"
            }
            Tab::Memory => "d drop caches  w clear swap  r re-auth sudo  ? help  q quit",
            Tab::Processes => "↑/↓ move  x SIGTERM  X SIGKILL  t sort RSS/CPU  ? help  q quit",
            Tab::Limiter => {
                "c CPU%  m MB  x restore  s save rule  d del rule  A reapply  / filter  ? help  q quit"
            }
            Tab::Logs => "↑/↓ scroll  PgUp/PgDn  c clear log  ? help  q quit",
        };
        f.render_widget(
            Paragraph::new(Line::from(Span::styled(hint, theme::subtle())))
                .style(theme::text()),
            chunk[3],
        );
    }

    fn draw_storage(f: &mut Frame, app: &App, area: Rect) {
        let widths = [
            Constraint::Length(3),
            Constraint::Length(26),
            Constraint::Length(12),
            Constraint::Min(10),
        ];
        // account for block borders (2) + header row (1)
        let (top, bottom) = window(app.targets.len(), app.cursor, area.height.saturating_sub(3) as usize);

        let rows: Vec<Row> = app
            .targets
            .iter()
            .enumerate()
            .skip(top)
            .take(bottom.saturating_sub(top))
            .map(|(i, row)| {
                let t = &row.target;
                let mark = if row.selected { "[x]" } else { "[ ]" };
                let size = match (t.state, t.size) {
                    (ScanState::Scanning, _) => "…".to_string(),
                    (ScanState::Pending, _) => "-".to_string(),
                    (_, Some(sz)) => display_bytes(sz),
                    (_, None) => "?".to_string(),
                };
                let style = if i == app.cursor {
                    Style::default()
                        .bg(theme::SURFACE)
                        .add_modifier(Modifier::BOLD)
                } else {
                    Style::default()
                };
                let fg = if i == app.cursor {
                    theme::MAUVE
                } else if row.selected {
                    theme::GREEN
                } else {
                    theme::TEXT
                };
                Row::new(vec![
                    Cell::from(mark),
                    Cell::from(t.name.clone()).style(Style::default().fg(fg)),
                    Cell::from(size).style(Style::default().fg(theme::PEACH)),
                    Cell::from(t.desc.clone()).style(Style::default().fg(theme::SUBTLE)),
                ])
                .style(style)
            })
            .collect();

        let title = scroll_title("Storage", top, bottom, app.targets.len());
        let table = Table::new(rows, widths)
            .header(Row::new(vec![
                Cell::from("sel"),
                Cell::from("target"),
                Cell::from("size"),
                Cell::from("description"),
            ]))
            .block(Block::default().borders(Borders::ALL).title(title));
        f.render_widget(table, area);
    }

    /// Build a table title with a scroll position indicator when overflowing.
    fn scroll_title(base: &str, top: usize, bottom: usize, total: usize) -> String {
        if total <= bottom.saturating_sub(top) || total == 0 {
            base.to_string()
        } else {
            format!("{}  {}/{}", base, bottom, total)
        }
    }

    /// Compute the visible slice [top, bottom) for a list given the selected
    /// cursor, keeping `cursor` on-screen. `visible` is the max rows we can show.
    fn window(total: usize, cursor: usize, visible: usize) -> (usize, usize) {
        if total == 0 || visible == 0 {
            return (0, 0);
        }
        let cursor = cursor.min(total.saturating_sub(1));
        if total <= visible {
            return (0, total);
        }
        let top = cursor
            .saturating_sub(visible - 1)
            .min(total.saturating_sub(visible));
        (top, top + visible)
    }

    fn draw_memory(f: &mut Frame, app: &App, area: Rect) {
        let m = &app.mem;
        let inner = Layout::vertical([
            Constraint::Length(3),
            Constraint::Length(3),
            Constraint::Length(3),
            Constraint::Length(4),
            Constraint::Length(1),
            Constraint::Min(4),
        ])
        .split(area);

        let ram_ratio = m.ratio(m.used_kb());
        let swap_ratio = m.swap_ratio();
        let reclaim_ratio = m.ratio(m.reclaimable_kb());

        let ram_gauge = Gauge::default()
            .block(Block::default().borders(Borders::ALL).title("RAM"))
            .gauge_style(Style::default().fg(theme::MAUVE))
            .ratio(ram_ratio)
            .label(format!(
                "{} / {}  ({}%)",
                display_bytes(m.used_kb() * 1024),
                display_bytes(m.total_kb * 1024),
                (ram_ratio * 100.0) as u64
            ));
        let swap_gauge = Gauge::default()
            .block(Block::default().borders(Borders::ALL).title("Swap"))
            .gauge_style(Style::default().fg(theme::BLUE))
            .ratio(swap_ratio)
            .label(format!(
                "{} / {}",
                display_bytes(m.swap_used_kb() * 1024),
                display_bytes(m.swap_total_kb * 1024)
            ));
        let reclaim_gauge = Gauge::default()
            .block(Block::default().borders(Borders::ALL).title("Reclaimable (page cache)"))
            .gauge_style(Style::default().fg(theme::GREEN))
            .ratio(reclaim_ratio)
            .label(format!(
                "{}  ({}%)",
                display_bytes(m.reclaimable_kb() * 1024),
                (reclaim_ratio * 100.0) as u64
            ));

        f.render_widget(ram_gauge, inner[0]);
        f.render_widget(swap_gauge, inner[1]);
        f.render_widget(reclaim_gauge, inner[2]);

        let hist: Vec<u64> = app.mem_history.iter().copied().collect();
        let spark = Sparkline::default()
            .block(Block::default().borders(Borders::ALL).title("RAM history (last samples)"))
            .style(Style::default().fg(theme::MAUVE))
