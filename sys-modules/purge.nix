    fn draw_logs(f: &mut Frame, app: &App, area: Rect) {
        let visible = area.height.saturating_sub(2) as usize;
        let total = app.log.len();

        // log_scroll = offset from the bottom (0 = latest visible). Slice accordingly.
        let scroll = app.log_scroll.min(total);
        let shown = visible.min(total - scroll);

        let start = if shown == 0 { total } else { total - scroll - shown };

        let lines: Vec<Line> = app
            .log
            .iter()
            .skip(start)
            .take(shown.max(1))
            .map(|entry| {
                let color = match entry.level {
                    LogLevel::Ok => theme::GREEN,
                    LogLevel::Err => theme::RED,
                    LogLevel::Warn => theme::YELLOW,
                    LogLevel::Info => theme::TEXT,
                };
                Line::from(Span::styled(entry.text.as_str(), Style::default().fg(color)))
            })
            .collect();
        let title = if scroll == 0 {
            "Log".to_string()
        } else {
            format!("Log  ({} above)", scroll)
        };
        f.render_widget(
            Paragraph::new(lines)
                .block(Block::default().borders(Borders::ALL).title(title))
                .style(theme::text()),
            area,
        );
    }

    /// A rectangle of the given size centered inside `area`.
    fn centered(area: Rect, w: u16, h: u16) -> Rect {
        let w = w.min(area.width);
        let h = h.min(area.height);
        Rect::new(
            area.x + (area.width.saturating_sub(w)) / 2,
            area.y + (area.height.saturating_sub(h)) / 2,
            w,
            h,
        )
    }

