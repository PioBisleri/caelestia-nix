  memoryRs = builtins.toFile "memory.rs" ''
    use std::fs;

    #[derive(Debug, Clone, Copy, Default)]
    pub struct MemInfo {
        pub total_kb: u64,
        pub free_kb: u64,
        pub available_kb: u64,
        pub buffers_kb: u64,
        pub cached_kb: u64,
        pub sreclaimable_kb: u64,
        pub swap_total_kb: u64,
        pub swap_free_kb: u64,
    }

    impl MemInfo {
        pub fn read() -> MemInfo {
            let mut m = MemInfo::default();
            if let Ok(data) = fs::read_to_string("/proc/meminfo") {
                for line in data.lines() {
                    let mut it = line.split_whitespace();
                    let key = it.next().unwrap_or("").trim_end_matches(':');
                    let val: u64 = it.next().and_then(|s| s.parse().ok()).unwrap_or(0);
                    match key {
                        "MemTotal" => m.total_kb = val,
                        "MemFree" => m.free_kb = val,
                        "MemAvailable" => m.available_kb = val,
                        "Buffers" => m.buffers_kb = val,
                        "Cached" => m.cached_kb = val,
                        "SReclaimable" => m.sreclaimable_kb = val,
                        "SwapTotal" => m.swap_total_kb = val,
                        "SwapFree" => m.swap_free_kb = val,
                        _ => {}
                    }
                }
            }
            m
        }

        /// Memory that is technically "used" but reclaimable (page cache).
        pub fn reclaimable_kb(&self) -> u64 {
            self.cached_kb + self.sreclaimable_kb
        }

        /// What drop-caches-style reclaim could target (cached + reclaimable slab).
        pub fn droppable_kb(&self) -> u64 {
            self.reclaimable_kb()
        }

        pub fn used_kb(&self) -> u64 {
            self.total_kb.saturating_sub(self.available_kb)
        }

        pub fn swap_used_kb(&self) -> u64 {
            self.swap_total_kb.saturating_sub(self.swap_free_kb)
        }

        pub fn ratio(&self, used: u64) -> f64 {
            if self.total_kb == 0 {
                0.0
            } else {
                used as f64 / self.total_kb as f64
            }
        }

        pub fn swap_ratio(&self) -> f64 {
            if self.swap_total_kb == 0 {
                0.0
            } else {
                self.swap_used_kb() as f64 / self.swap_total_kb as f64
            }
        }
    }

    pub fn drop_caches_needs_root() -> bool {
        true
    }
  '';

  procsRs = builtins.toFile "procs.rs" ''
    use std::collections::HashMap;
    use std::fs;

    #[derive(Debug, Clone)]
    pub struct Proc {
        pub pid: i64,
        pub name: String,
        pub comm: String,
        pub rss_kb: u64,
        pub cpu_pct: f64,
        pub cmd: String,
    }

    /// List running processes sorted by RSS or CPU (descending), top `limit`.
    pub fn top_processes(limit: usize, by_cpu: bool) -> Vec<Proc> {
        let mut procs = Vec::new();
        if let Ok(entries) = fs::read_dir("/proc") {
            for e in entries.flatten() {
                let name = e.file_name();
                let pid = match name.to_str().and_then(|s| s.parse::<i64>().ok()) {
                    Some(p) => p,
                    None => continue,
                };
                let status_path = format!("/proc/{}/status", pid);
                let comm_path = format!("/proc/{}/comm", pid);
                let (rss, _statname) = read_status(&status_path);
                let cmdline = fs::read_to_string(format!("/proc/{}/cmdline", pid))
                    .unwrap_or_default()
                    .replace('\0', " ");
                let comm = match fs::read_to_string(&comm_path) {
                    Ok(c) => c.trim().to_string(),
                    Err(_) => continue,
                };
                procs.push(Proc {
                    pid,
                    rss_kb: rss,
                    name: comm_label(&comm),
                    comm,
                    cpu_pct: 0.0,
                    cmd: cmdline.trim().to_string(),
                });
            }
        }
        if by_cpu {
            procs.sort_by(|a, b| b.cpu_pct.partial_cmp(&a.cpu_pct).unwrap_or(std::cmp::Ordering::Equal));
        } else {
            procs.sort_by(|a, b| b.rss_kb.cmp(&a.rss_kb));
        }
        procs.truncate(limit);
        procs
    }

    /// Raw utime+stime jiffies for a pid (fields 14+15 of /proc/pid/stat).
    pub fn cpu_ticks(pid: i64) -> Option<u64> {
        let data = fs::read_to_string(format!("/proc/{}/stat", pid)).ok()?;
        let after = data.rsplit_once(')')?.1;
        let fields: Vec<&str> = after.split_whitespace().collect();
        // after comm: [0]=state ... utime is overall field 14 => index 11 here
        let utime: u64 = fields.get(11)?.parse().ok()?;
        let stime: u64 = fields.get(12)?.parse().ok()?;
        Some(utime + stime)
    }

    /// All pids whose raw /proc/<pid>/comm exactly matches `name`.
    pub fn comms_matching(name: &str) -> Vec<i64> {
        let mut pids = Vec::new();
        if let Ok(entries) = fs::read_dir("/proc") {
            for e in entries.flatten() {
                let pid = match e.file_name().to_str().and_then(|s| s.parse::<i64>().ok()) {
                    Some(p) => p,
                    None => continue,
                };
                if let Ok(c) = fs::read_to_string(format!("/proc/{}/comm", pid)) {
                    if c.trim() == name {
                        pids.push(pid);
                    }
                }
            }
        }
        pids
    }

    fn read_status(path: &str) -> (u64, String) {
        let data = match fs::read_to_string(path) {
            Ok(d) => d,
            Err(_) => return (0, String::new()),
        };
        let mut rss = 0u64;
        let mut name = String::new();
        for line in data.lines() {
            let mut it = line.splitn(2, ':');
            let key = it.next().unwrap_or("").trim();
            let val = it.next().unwrap_or("").trim();
            match key {
                "Name" => name = val.to_string(),
                "VmRSS" => {
                    rss = val
                        .split_whitespace()
                        .next()
                        .and_then(|s| s.parse().ok())
                        .unwrap_or(0)
                }
                _ => {}
            }
        }
        (rss, name)
    }

    fn comm_label(comm: &str) -> String {
        let body = comm.trim_matches(|c| c == '[' || c == ']');
        if body.len() > 24 {
            body.chars().take(21).collect::<String>() + "..."
        } else {
            body.to_string()
        }
    }

    /// Compute per-process CPU% from consecutive tick samples.
    /// `prev`: pid -> (ticks, sample instant). Returns updated map and fills pct.
    pub fn sample_cpu(
        procs: &mut [Proc],
        prev: &mut HashMap<i64, (u64, std::time::Instant)>,
        hz: f64,
    ) {
        use std::time::Instant;
        let now = Instant::now();
        let mut next: HashMap<i64, (u64, Instant)> = HashMap::new();
        for p in procs.iter_mut() {
            if let Some(ticks) = cpu_ticks(p.pid) {
                if let Some(&(pt, ti)) = prev.get(&p.pid) {
                    let dt = now.duration_since(ti).as_secs_f64();
                    if dt > 0.05 && ticks >= pt {
                        p.cpu_pct = ((ticks - pt) as f64) / (hz * dt) * 100.0;
                        if p.cpu_pct > 999.0 {
                            p.cpu_pct = 999.0;
                        }
                    }
                }
                next.insert(p.pid, (ticks, now));
            }
        }
        *prev = next;
    }
  '';

  storageRs = builtins.toFile "storage.rs" ''
    use std::fs;
    use std::process::Command;

    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum CleanKind {
        Tool,
        EmptyDir,
        RemDir,
    }

    #[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
    pub enum ScanState {
        #[default]
        Pending,
        Scanning,
        Done,
        Missing,
    }

    #[derive(Debug, Clone)]
    pub struct CleanTarget {
        pub name: String,
        pub desc: String,
        pub kind: CleanKind,
        pub cmd: Vec<String>,
        pub needs_root: bool,
        pub size: Option<u64>,
        pub state: ScanState,
    }

    impl CleanTarget {
        pub fn can_clean(&self) -> bool {
            self.size.unwrap_or(0) > 0
        }

        pub fn is_dir(&self) -> bool {
            matches!(self.kind, CleanKind::EmptyDir | CleanKind::RemDir)
        }
    }

    /// Compute directory size in bytes (`du -sb`), optionally via `sudo -n`.
    pub fn dir_size(path: &str, needs_root: bool) -> Option<u64> {
        let out = if needs_root {
            Command::new("sudo")
                .args(["-n", "du", "-sb", path])
                .output()
                .ok()?
        } else {
            Command::new("du").args(["-sb", path]).output().ok()?
        };
        if !out.status.success() {
            return None;
        }
        let line = String::from_utf8_lossy(&out.stdout);
        let bytes: u64 = line.split_whitespace().next()?.parse().ok()?;
        Some(bytes)
    }

    /// Empty a directory's contents, keeping the directory itself.
    pub fn empty_dir(path: &str) -> Result<String, String> {
        let out = Command::new("find")
            .arg(path)
            .arg("-mindepth")
            .arg("1")
            .args(["-delete"])
            .output()
            .map_err(|e| e.to_string())?;
        if out.status.success() {
            Ok(String::from_utf8_lossy(&out.stderr).trim().to_string())
        } else {
            Err(String::from_utf8_lossy(&out.stderr).trim().to_string())
        }
    }

    /// Remove an entire directory tree.
    pub fn rm_dir(path: &str) -> Result<(), String> {
        let out = Command::new("rm")
            .args(["-rf", "--", path])
            .output()
            .map_err(|e| e.to_string())?;
        if out.status.success() {
            Ok(())
        } else {
            Err(String::from_utf8_lossy(&out.stderr).trim().to_string())
        }
    }

    /// Friendly descriptions for well-known ~/.cache directories.
    const KNOWN_CACHE_DESCS: &[(&str, &str)] = &[
        ("BraveSoftware", "Brave browser cache"),
        ("brave-software", "Brave browser cache"),
        ("puppeteer", "Puppeteer downloaded browsers"),
        ("spotify", "Spotify web player cache"),
        ("tts", "TTS voices (re-downloads when used)"),
        ("kitty", "kitty screenshots & thumbnails"),
        ("hyprland", "Hyprland crash reports & logs"),
        ("nvim", "Neovim swap/shada"),
        ("fontconfig", "fontconfig cache (regenerates)"),
        ("matugen", "matugen generated assets"),
        ("QtProject", "Qt project settings"),
    ];

    /// Curated cache names already present as dedicated targets; skip them during
    /// auto-discovery so nothing is listed twice.
    const CURATED_CACHE_NAMES: &[&str] = &[
        "nix",
        "go-build",
        "wine",
        "kdenlive",
        "thumbnails",
        "appimage-run",
        "webapps",
        "cliphist",
        "mesa_shader_cache",
    ];

    fn tool(name: &str, desc: &str, cmd: Vec<String>, needs_root: bool) -> CleanTarget {
        CleanTarget {
            name: name.to_string(),
            desc: desc.to_string(),
            kind: CleanKind::Tool,
            cmd,
            needs_root,
            size: None,
            state: ScanState::Pending,
        }
    }

    fn dir(name: &str, desc: &str, path: String) -> CleanTarget {
        CleanTarget {
            name: name.to_string(),
            desc: desc.to_string(),
            kind: CleanKind::EmptyDir,
            cmd: vec![path],
            needs_root: false,
            size: None,
            state: ScanState::Pending,
        }
    }

    /// Default set of cleanup targets: pinned system tools first, then curated
    /// caches, then every remaining directory under ~/.cache (auto-discovered).
    pub fn default_targets(home: &str) -> Vec<CleanTarget> {
        let hm_profile = format!("{}/.local/state/nix/profiles/profile", home);
        let mut t: Vec<CleanTarget> = Vec::new();

        t.push(tool(
            "Nix store GC",
            "nix-store --gc  (frees dead store paths)",
            vec!["nix-store".into(), "--gc".into()],
            false,
        ));
        t.push(tool(
            "Nix store optimise",
            "nix-store --optimise  (dedupe hard links)",
            vec!["nix-store".into(), "--optimise".into()],
            false,
        ));
        t.push(tool(
            "Home-manager generations",
            "delete generations older than 7d",
            vec![
                "nix-env".into(),
                "-p".into(),
                hm_profile,
                "--delete-generations".into(),
                "7d".into(),
            ],
            false,
        ));
        t.push(tool(
            "Systemd journal",
            "journalctl --vacuum-size=100M (root)",
            vec!["journalctl".into(), "--vacuum-size=100M".into()],
            true,
        ));
        t.push(tool(
            "/boot stale files",
            "rm /boot *.tmp + EFI.bak-* + grub.bak-* (root)",
            vec![
                "sh".into(),
                "-c".into(),
                "rm -f /boot/*.tmp /boot/EFI.bak-* /boot/grub.bak-*".into(),
            ],
            true,
        ));
        t.push(tool(
            "/etc backups >3d",
            "delete /etc/nixos.backup-* older than 3 days (root)",
            vec![
                "sh".into(),
                "-c".into(),
                "find /etc -maxdepth 1 -name 'nixos.backup-*' -mtime +3 -exec rm -rf {} +".into(),
            ],
            true,
        ));

        let curated: Vec<(&str, &str)> = vec![
            ("nix", "flake/fetcher cache metadata"),
            ("go-build", "Go build cache"),
            ("wine", "Wine renderer shader cache"),
            ("kdenlive", "Kdenlive media cache"),
            ("thumbnails", "File manager thumbnails"),
            ("appimage-run", "Extracted AppImage mounts"),
            ("webapps", "Web app (instagram/notebooklm) cache"),
            ("cliphist", "Clipboard history DB"),
            ("mesa_shader_cache", "Mesa shader cache"),
        ];
        for (name, desc) in curated {
            let path = format!("{}/.cache/{}", home, name);
            t.push(dir(name, desc, path));
        }

        t.push(tool(
            "npm cache",
            "npm cache clean --force",
            vec!["npm".into(), "cache".into(), "clean".into(), "--force".into()],
            false,
        ));
        t.push(dir(
            "Trash",
            "empty ~/.local/share/Trash",
            format!("{}/.local/share/Trash", home),
        ));

        // Auto-discover every remaining directory under ~/.cache.
        if let Ok(entries) = fs::read_dir(format!("{}/.cache", home)) {
            let mut extra: Vec<CleanTarget> = Vec::new();
            for e in entries.flatten() {
                let path = e.path();
                if !path.is_dir() {
                    continue;
                }
                let name = match path.file_name().and_then(|n| n.to_str()) {
                    Some(n) => n.to_string(),
                    None => continue,
                };
                if CURATED_CACHE_NAMES.contains(&name.as_str()) {
                    continue;
                }
                let desc = KNOWN_CACHE_DESCS
                    .iter()
                    .find(|(n, _)| n.eq_ignore_ascii_case(&name))
                    .map(|(_, d)| d.to_string())
                    .unwrap_or_else(|| format!("auto-discovered cache (~/.cache/{})", name));
                extra.push(dir(&name, &desc, path.to_string_lossy().to_string()));
            }
            extra.sort_by_key(|c| c.name.to_lowercase());
            t.extend(extra);
        }

        t
    }
  '';

  runnerRs = builtins.toFile "runner.rs" ''
    use std::process::Command;

    use crate::storage::{CleanKind, CleanTarget};

    #[derive(Debug, Clone)]
    pub enum LogLevel {
        Info,
        Ok,
        Warn,
        Err,
    }

    #[derive(Debug, Clone)]
    pub struct JobLog {
        pub level: LogLevel,
        pub text: String,
    }

    pub fn display_size(bytes: u64) -> String {
        const UNITS: [&str; 6] = ["B", "KiB", "MiB", "GiB", "TiB", "PiB"];
        if bytes == 0 {
            return "0 B".to_string();
        }
        let mut v = bytes as f64;
        let mut i = 0;
        while v >= 1024.0 && i < UNITS.len() - 1 {
            v /= 1024.0;
            i += 1;
        }
        if i == 0 {
            format!("{} {}", bytes, UNITS[i])
        } else {
            format!("{:.1} {}", v, UNITS[i])
        }
    }

    fn expand(p: &str) -> String {
        let home = std::env::var("HOME").unwrap_or_default();
        p.replace("~", &home)
    }

    /// Scan a target's size in bytes (if it is a directory target).
    pub fn scan_target(t: &CleanTarget) -> Option<u64> {
        match t.kind {
            CleanKind::EmptyDir | CleanKind::RemDir => {
                let path = expand(t.cmd.get(0)?);
                if t.needs_root && !crate::sudo::have_sudo() {
                    return None;
                }
                crate::storage::dir_size(&path, t.needs_root)
            }
            CleanKind::Tool => None,
        }
    }

    /// Execute a single cleanup action for a target. Returns (ok, message).
    pub fn clean_target(t: &CleanTarget) -> Result<(bool, String), String> {
        match t.kind {
            CleanKind::EmptyDir => {
                let path = expand(t.cmd.get(0).ok_or("no path")?);
                let (ok, msg) = run_owned("find", &[&path, "-mindepth", "1", "-delete"], t.needs_root)?;
                Ok((ok, msg))
            }
            CleanKind::RemDir => {
                let path = expand(t.cmd.get(0).ok_or("no path")?);
                let (ok, msg) = run_owned("rm", &["-rf", "--", &path], false)?;
                Ok((ok, msg))
            }
            CleanKind::Tool => {
                let bin = t.cmd.get(0).cloned().unwrap_or_default();
                let args: Vec<String> = t.cmd.get(1..).unwrap_or(&[]).to_vec();
                let arg_refs: Vec<&str> = args.iter().map(|s| s.as_str()).collect();
                let (ok, msg) = run_owned(&bin, &arg_refs, t.needs_root)?;
                Ok((ok, msg))
            }
        }
    }

    fn run_owned(bin: &str, args: &[&str], needs_root: bool) -> Result<(bool, String), String> {
        if needs_root && !crate::sudo::have_sudo() {
            return Err("sudo auth needed - press r to cache".into());
        }
        let pretty = if needs_root {
            format!("sudo -n {} {}", bin, args.join(" "))
        } else {
            format!("{} {}", bin, args.join(" "))
        };

        let mut cmd = Command::new(if needs_root { "sudo" } else { bin });
        if needs_root {
            cmd.args(["-n", bin]);
        }
        cmd.args(args);

        let out = cmd.output().map_err(|e| e.to_string())?;
        let ok = out.status.success();
        let stderr = String::from_utf8_lossy(&out.stderr).trim().to_string();
        let stdout = String::from_utf8_lossy(&out.stdout).trim().to_string();
        let tail = if !stderr.is_empty() {
            stderr
        } else {
            let s: String = stdout.chars().take(200).collect();
            if !s.is_empty() { s } else { String::new() }
        };

        Ok((ok, if tail.is_empty() { pretty } else { format!("{} => {}", pretty, tail) }))
    }
  '';

  sudoRs = builtins.toFile "sudo.rs" ''
    use std::process::{Command, Stdio};

    /// Interactively refresh sudo credentials. Must be called with the
    /// terminal in a state that can show the password prompt (raw mode off).
    pub fn interactive_auth() {
        let _ = Command::new("sudo").arg("-v").status();
    }

    /// Check whether sudo credentials are already cached (non-interactive).
    pub fn have_sudo() -> bool {
        Command::new("sudo")
            .args(["-n", "true"])
            .stdin(Stdio::null())
            .stdout(Stdio::null())
            .stderr(Stdio::null())
            .status()
            .map(|s| s.success())
            .unwrap_or(false)
    }

    /// Run a command with cached sudo credentials. Fails if not authenticated.
    pub fn run_sudo(args: &[&str]) -> Result<std::process::ExitStatus, String> {
        Command::new("sudo")
            .args(["-n"])
            .args(args)
            .output()
            .map(|o| o.status)
            .map_err(|e| e.to_string())
    }

    pub fn run_cmd(args: &[&str]) -> Result<std::process::ExitStatus, String> {
        Command::new(args[0])
            .args(&args[1..])
            .output()
            .map(|o| o.status)
            .map_err(|e| e.to_string())
    }
  '';

in
rustPlatform.buildRustPackage {
  pname = "purge";
  version = "0.2.0";
  src = stdenv.mkDerivation {
    pname = "purge-crate-src";
    version = "0.2.0";
    buildCommand = ''
      mkdir -p $out/src
      cp ${mainRs} $out/src/main.rs
      cp ${appRs} $out/src/app.rs
      cp ${uiRs} $out/src/ui.rs
      cp ${themeRs} $out/src/theme.rs
      cp ${memoryRs} $out/src/memory.rs
      cp ${procsRs} $out/src/procs.rs
      cp ${storageRs} $out/src/storage.rs
      cp ${runnerRs} $out/src/runner.rs
      cp ${sudoRs} $out/src/sudo.rs
      cp ${limitsRs} $out/src/limits.rs
      cp ${cargoToml} $out/Cargo.toml
      cp ${cargoLock} $out/Cargo.lock
    '';
  };
  cargoLock.lockFile = cargoLock;
  nativeBuildInputs = [ makeWrapper ];
  postInstall = ''
    wrapProgram $out/bin/purge \
      --prefix PATH : "${lib.makeBinPath [ nodejs ]}"
  '';
  meta = {
    description = "Catppuccin-themed RAM and storage cleanup TUI for NixOS";
    license = lib.licenses.mit;
    mainProgram = "purge";
  };
}
