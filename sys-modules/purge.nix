  mainRs = builtins.toFile "main.rs" ''
    mod app;
    mod limits;
    mod memory;
    mod procs;
    mod runner;
    mod storage;
    mod sudo;
    mod theme;
    mod ui;

    use std::io;

    use app::{App, Tab};
    use crossterm::{
        event::{self, Event, KeyCode, KeyEventKind},
        execute,
        terminal::{disable_raw_mode, enable_raw_mode, EnterAlternateScreen, LeaveAlternateScreen},
    };
    use ratatui::backend::CrosstermBackend;
    use ratatui::Terminal;

    fn main() -> io::Result<()> {
        let args: Vec<String> = std::env::args().skip(1).collect();
        if args.iter().any(|a| a == "--help" || a == "-h") {
            println!("purge - Catppuccin RAM + storage cleanup TUI");
            println!("usage: purge [--apply-limits]");
            println!("  --apply-limits   apply saved limit rules headlessly and exit");
            return Ok(());
        }
        if args.iter().any(|a| a == "--apply-limits") {
            let mut state = limits::load_state();
            match limits::apply_rules(&mut state) {
                Ok((n, notes)) => {
                    println!("purge: applied {} limit(s)", n);
                    for note in notes {
                        println!("  {}", note);
                    }
                }
                Err(e) => {
                    eprintln!("purge: {}", e);
                    std::process::exit(1);
                }
            }
            return Ok(());
        }

        let mut stdout = io::stdout();
        enable_raw_mode()?;
        execute!(stdout, EnterAlternateScreen)?;
        let backend = CrosstermBackend::new(stdout);
        let mut terminal = Terminal::new(backend)?;

        let mut app = App::new();
        let result = run(&mut terminal, &mut app);

        disable_raw_mode()?;
        execute!(io::stdout(), LeaveAlternateScreen)?;
        terminal.show_cursor()?;
        result
    }

    fn run(terminal: &mut Terminal<CrosstermBackend<io::Stdout>>, app: &mut App) -> io::Result<()> {
        loop {
            terminal.draw(|f| ui::draw(f, app))?;
            app.refresh();

            if event::poll(std::time::Duration::from_millis(80))? {
                match event::read()? {
                    Event::Key(key) => {
                        if key.kind == KeyEventKind::Press {
                            let idle = app.input.is_none() && !app.help && !app.confirm_clean;
                            if idle && key.code == KeyCode::Char('r') && app.tab == Tab::Memory {
                                suspended_sudo(terminal)?;
                                app.sudo_ok = crate::sudo::have_sudo();
                                app.push_log(runner::LogLevel::Ok, "sudo credentials refreshed".into());
                            } else if app.handle_key(key.code) {
                                return Ok(());
                            }
                        }
                    }
                    Event::Resize(_, _) => {}
                    _ => {}
                }
            }
        }
    }

    /// Suspend the TUI, run sudo -v interactively, then resume.
    fn suspended_sudo(terminal: &mut Terminal<CrosstermBackend<io::Stdout>>) -> io::Result<()> {
        execute!(io::stdout(), LeaveAlternateScreen)?;
        disable_raw_mode()?;
        let _ = sudo::interactive_auth();
        enable_raw_mode()?;
        execute!(io::stdout(), EnterAlternateScreen)?;
        terminal.clear()?;
        Ok(())
    }
  '';

  limitsRs = builtins.toFile "limits.rs" ''
    use std::fs;
    use std::path::PathBuf;

    #[derive(Debug, Clone, Default)]
    pub struct Limit {
        pub cpu_pct: Option<u32>,
        pub mem_mb: Option<u64>,
    }

    impl Limit {
        pub fn is_empty(&self) -> bool {
            self.cpu_pct.is_none() && self.mem_mb.is_none()
        }

        pub fn display(&self) -> String {
            let mut parts = Vec::new();
            if let Some(c) = self.cpu_pct {
                parts.push(format!("{}%", c));
            }
            if let Some(m) = self.mem_mb {
                parts.push(format!("{}M", m));
            }
            if parts.is_empty() {
                "-".to_string()
            } else {
                parts.join(" / ")
            }
        }
    }

    /// A pid currently limited by purge, with the cgroup to restore on `x`.
    #[derive(Debug, Clone)]
    pub struct Applied {
        pub pid: i64,
        pub name: String,
        pub orig: String,
        pub lim: Limit,
    }

    #[derive(Debug, Clone)]
    pub struct Rule {
        pub name: String,
        pub lim: Limit,
    }

    fn uid() -> u32 {
        if let Ok(data) = fs::read_to_string("/proc/self/status") {
            for line in data.lines() {
                if let Some(rest) = line.strip_prefix("Uid:") {
                    if let Some(u) = rest.split_whitespace().next().and_then(|s| s.parse().ok()) {
                        return u;
                    }
                }
            }
        }
        1000
    }

    fn cg_base() -> PathBuf {
        let u = uid();
        PathBuf::from(format!(
            "/sys/fs/cgroup/user.slice/user-{}.slice/user@{}.service",
            u, u
        ))
    }

    fn purge_root() -> PathBuf {
        cg_base().join("purge")
    }

    /// Current cgroup path of a pid (from /proc/<pid>/cgroup), if any.
    pub fn cg_of(pid: i64) -> Option<String> {
        let data = fs::read_to_string(format!("/proc/{}/cgroup", pid)).ok()?;
        for line in data.lines() {
            if let Some(path) = line.strip_prefix("0::") {
                return Some(path.trim().to_string());
            }
        }
        None
    }

    pub fn in_purge(pid: i64) -> bool {
        cg_of(pid).map(|c| c.contains("/purge/")).unwrap_or(false)
    }

    /// Create purge/ under the user slice and make sure cpu+memory controllers
    /// are delegated to its children (required at every cgroup level).
    fn ensure_purge_root() -> Result<PathBuf, String> {
        let root = purge_root();
        fs::create_dir_all(&root).map_err(|e| format!("mkdir {}: {}", root.display(), e))?;
        let sc = root.join("cgroup.subtree_control");
        let cur = fs::read_to_string(&sc).unwrap_or_default();
        if !cur.split_whitespace().any(|w| w == "cpu" || w == "+cpu") {
            fs::write(&sc, "+cpu +memory").map_err(|e| format!("subtree_control: {}", e))?;
        }
        Ok(root)
    }

    fn sanitize(name: &str) -> String {
        let mut out: String = name
            .chars()
            .map(|c| {
                if c.is_ascii_alphanumeric() || c == '.' || c == '-' || c == '_' {
                    c
                } else {
                    '-'
                }
            })
            .take(24)
            .collect();
        if out.trim_matches('-').is_empty() {
            out = "proc".to_string();
        }
        out
    }

    fn state_path() -> PathBuf {
        let home = std::env::var("HOME").unwrap_or_default();
        PathBuf::from(format!("{}/.local/state/purge/limits.state", home))
    }

    fn rules_path() -> PathBuf {
        let home = std::env::var("HOME").unwrap_or_default();
        PathBuf::from(format!("{}/.config/purge/limits.conf", home))
    }

    pub fn load_state() -> Vec<Applied> {
        let mut out = Vec::new();
        if let Ok(data) = fs::read_to_string(state_path()) {
            for line in data.lines() {
                if line.trim().is_empty() || line.starts_with('#') {
                    continue;
                }
                let f: Vec<&str> = line.split('\t').collect();
                if f.len() < 4 {
                    continue;
                }
                let pid: i64 = match f[0].parse() {
                    Ok(p) => p,
                    Err(_) => continue,
                };
                let mut lim = Limit::default();
                if let Ok(v) = f[3].parse() {
                    if v > 0 {
                        lim.cpu_pct = Some(v);
                    }
                }
                if f.len() > 4 {
                    if let Ok(v) = f[4].parse() {
                        if v > 0 {
                            lim.mem_mb = Some(v);
                        }
                    }
                }
                out.push(Applied {
                    pid,
                    name: f[1].to_string(),
                    orig: f[2].to_string(),
                    lim,
                });
            }
        }
        out
    }

    fn save_state(state: &[Applied]) -> Result<(), String> {
        let path = state_path();
        if let Some(dir) = path.parent() {
            fs::create_dir_all(dir).map_err(|e| e.to_string())?;
        }
        let mut buf = String::new();
        for a in state {
            buf.push_str(&format!(
                "{}\t{}\t{}\t{}\t{}\n",
                a.pid,
                a.name,
                a.orig,
                a.lim.cpu_pct.map(|v| v.to_string()).unwrap_or_default(),
                a.lim.mem_mb.map(|v| v.to_string()).unwrap_or_default(),
            ));
        }
        fs::write(&path, buf).map_err(|e| format!("write {}: {}", path.display(), e))
    }

    /// Apply a CPU and/or memory limit to a pid by moving it into
    /// purge/<name>-<pid> and writing cpu.max / memory.max.
    /// Merges with an existing state entry (keeps the original cgroup).
    pub fn apply(pid: i64, name: &str, lim: &Limit, state: &mut Vec<Applied>) -> Result<String, String> {
        if lim.is_empty() {
            return Err("nothing to apply".into());
        }
        let idx = state.iter().position(|a| a.pid == pid);
        let orig = match idx {
            Some(i) => state[i].orig.clone(),
            None => cg_of(pid).ok_or_else(|| format!("cannot read cgroup of pid {}", pid))?,
        };
        let root = ensure_purge_root()?;
        let cg = root.join(format!("{}-{}", sanitize(name), pid));
        fs::create_dir_all(&cg).map_err(|e| format!("mkdir {}: {}", cg.display(), e))?;
        fs::write(cg.join("cgroup.procs"), pid.to_string())
            .map_err(|e| format!("move pid {}: {}", pid, e))?;

        let mut msgs = Vec::new();
        if let Some(p) = lim.cpu_pct {
            let p = p.clamp(1, 100);
            let quota = p as u64 * 1000;
            fs::write(cg.join("cpu.max"), format!("{} 100000", quota))
                .map_err(|e| format!("cpu.max: {}", e))?;
            msgs.push(format!("cpu {}%", p));
        }
        if let Some(m) = lim.mem_mb {
            fs::write(cg.join("memory.max"), (m * 1024 * 1024).to_string())
                .map_err(|e| format!("memory.max: {}", e))?;
            msgs.push(format!("mem {}M", m));
        }

        match idx {
            Some(i) => {
                if lim.cpu_pct.is_some() {
                    state[i].lim.cpu_pct = lim.cpu_pct;
                }
                if lim.mem_mb.is_some() {
                    state[i].lim.mem_mb = lim.mem_mb;
                }
            }
            None => state.push(Applied {
                pid,
                name: name.to_string(),
                orig,
                lim: lim.clone(),
            }),
        }
        save_state(state)?;
        Ok(msgs.join(" + "))
    }

    /// Move a pid back to its original cgroup and drop the state entry.
    pub fn restore(pid: i64, state: &mut Vec<Applied>) -> Result<String, String> {
        let idx = state
            .iter()
            .position(|a| a.pid == pid)
            .ok_or_else(|| format!("pid {} is not limited by purge", pid))?;
        let entry = state.remove(idx);
        if cg_of(pid).map(|c| c.contains("/purge/")).unwrap_or(false) {
            let dest = format!("/sys/fs/cgroup{}/cgroup.procs", entry.orig);
            fs::write(&dest, pid.to_string()).map_err(|e| format!("restore: {}", e))?;
        }
        save_state(state)?;
        reap_empty();
        Ok(format!("restored {}", entry.name))
    }

    /// Remove purge/* cgroups that no longer hold processes or children.
    pub fn reap_empty() {
        let root = purge_root();
        if let Ok(entries) = fs::read_dir(&root) {
            for e in entries.flatten() {
                let p = e.path();
                if !p.is_dir() {
                    continue;
                }
                let procs = fs::read_to_string(p.join("cgroup.procs")).unwrap_or_default();
                let has_kids = fs::read_dir(&p)
                    .map(|it| it.flatten().any(|c| c.path().is_dir()))
                    .unwrap_or(false);
                if procs.trim().is_empty() && !has_kids {
                    let _ = fs::remove_dir(&p);
                }
            }
        }
        // best effort: drop purge/ itself when fully empty
        let _ = fs::remove_dir(&root);
    }

    pub fn load_rules() -> Vec<Rule> {
        let mut out = Vec::new();
        if let Ok(data) = fs::read_to_string(rules_path()) {
            for line in data.lines() {
                let line = line.trim();
                if line.is_empty() || line.starts_with('#') {
                    continue;
                }
                let mut it = line.split_whitespace();
                let name = match it.next() {
                    Some(n) => n.to_string(),
                    None => continue,
                };
                let mut lim = Limit::default();
                for tok in it {
                    if let Some(v) = tok.strip_prefix("cpu=") {
                        lim.cpu_pct = v.parse().ok().filter(|p| *p >= 1);
                    } else if let Some(v) = tok.strip_prefix("mem=") {
                        lim.mem_mb = v.parse().ok().filter(|m| *m >= 1);
                    }
                }
                if !lim.is_empty() {
                    out.push(Rule { name, lim });
                }
            }
        }
        out
    }

    fn save_rules(rules: &[Rule]) -> Result<(), String> {
        let path = rules_path();
        if let Some(dir) = path.parent() {
            fs::create_dir_all(dir).map_err(|e| e.to_string())?;
        }
        let mut buf = String::from("# purge limit rules: <comm> cpu=<percent> mem=<megabytes>\n");
        for r in rules {
            let mut parts = Vec::new();
            if let Some(c) = r.lim.cpu_pct {
                parts.push(format!("cpu={}", c));
            }
            if let Some(m) = r.lim.mem_mb {
                parts.push(format!("mem={}", m));
            }
            buf.push_str(&format!("{} {}\n", r.name, parts.join(" ")));
        }
        fs::write(&path, buf).map_err(|e| format!("write {}: {}", path.display(), e))
    }

    /// Insert or replace the rule for `name`.
    pub fn save_rule(name: &str, lim: &Limit) -> Result<String, String> {
        if lim.is_empty() {
            return Err("no limit to save (apply c/m first)".into());
        }
        let mut rules = load_rules();
        match rules.iter_mut().position(|r| r.name == name) {
            Some(i) => {
                if lim.cpu_pct.is_some() {
                    rules[i].lim.cpu_pct = lim.cpu_pct;
                }
                if lim.mem_mb.is_some() {
                    rules[i].lim.mem_mb = lim.mem_mb;
                }
            }
            None => rules.push(Rule {
                name: name.to_string(),
                lim: lim.clone(),
            }),
        }
        save_rules(&rules)?;
        Ok(format!("rule saved for {}", name))
    }

    pub fn delete_rule(name: &str) -> Result<String, String> {
        let mut rules = load_rules();
        let before = rules.len();
        rules.retain(|r| r.name != name);
        if rules.len() == before {
            return Err(format!("no rule for {}", name));
        }
        save_rules(&rules)?;
        Ok(format!("rule deleted for {}", name))
    }

    /// Apply every saved rule to all processes whose comm matches.
    /// Used by `A` in the TUI and `purge --apply-limits` at login.
    pub fn apply_rules(state: &mut Vec<Applied>) -> Result<(usize, Vec<String>), String> {
        let rules = load_rules();
        let mut applied = 0usize;
        let mut notes = Vec::new();
        for rule in &rules {
            let pids = crate::procs::comms_matching(&rule.name);
            if pids.is_empty() {
                notes.push(format!("{}: not running", rule.name));
                continue;
            }
            for pid in pids {
                match apply(pid, &rule.name, &rule.lim, state) {
                    Ok(_) => applied += 1,
                    Err(e) => notes.push(format!("{}[{}]: {}", rule.name, pid, e)),
                }
            }
        }
        reap_empty();
        Ok((applied, notes))
    }
  '';

  appRs = builtins.toFile "app.rs" ''
    use std::collections::HashMap;
    use std::collections::VecDeque;
    use std::sync::mpsc::{self, Receiver, TryRecvError};
    use std::time::{Duration, Instant};

    use crate::limits::{self, Limit};
    use crate::memory::MemInfo;
    use crate::procs::Proc;
    use crate::runner::{self, JobLog, LogLevel};
    use crate::storage::{CleanTarget, ScanState};
    use crossterm::event::KeyCode;

    pub const SPINNER: [&str; 10] = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
    const MEM_HISTORY: usize = 60;
    const HZ: f64 = 100.0;

    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum Tab {
        Storage,
        Memory,
        Processes,
        Limiter,
        Logs,
    }

    impl Tab {
        pub fn name(self) -> &'static str {
            match self {
                Tab::Storage => "Storage",
                Tab::Memory => "Memory",
                Tab::Processes => "Processes",
                Tab::Limiter => "Limiter",
                Tab::Logs => "Logs",
            }
        }
    }

    const TABS: [Tab; 5] = [
        Tab::Storage,
        Tab::Memory,
        Tab::Processes,
        Tab::Limiter,
        Tab::Logs,
    ];

    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum InputMode {
        Cpu,
        Mem,
        Filter,
    }

    enum CleanMsg {
        Log(LogLevel, String),
        Done,
    }

    #[derive(Clone)]
    pub struct TargetRow {
        pub target: CleanTarget,
        pub selected: bool,
    }

    pub struct App {
        pub tab: Tab,
        pub targets: Vec<TargetRow>,
        pub mem: MemInfo,
        pub mem_history: VecDeque<u64>,
        pub procs: Vec<Proc>,
        pub log: VecDeque<JobLog>,
        pub cursor: usize,
        pub proc_cursor: usize,
        /// Offset from the bottom of the log (0 = latest line visible).
        pub log_scroll: usize,
        pub scanning: bool,
        pub scan_rx: Option<Receiver<(usize, Option<u64>)>>,
        pub cleaning: bool,
        pub clean_rx: Option<Receiver<CleanMsg>>,
        pub last_refresh: Instant,
        pub sudo_ok: bool,
        pub spinner: usize,
        // Limiter / UI state
        pub applied: Vec<limits::Applied>,
        pub rules: Vec<limits::Rule>,
        pub filter: String,
        pub input: Option<InputMode>,
        pub input_buf: String,
        pub confirm_clean: bool,
        pub help: bool,
        pub by_cpu: bool,
        prev_cpu: HashMap<i64, (u64, Instant)>,
    }

    impl App {
        pub fn new() -> Self {
            let home = std::env::var("HOME").unwrap_or_default();
            let mem = MemInfo::read();
            let mut mem_history = VecDeque::new();
            mem_history.push_back(mem.used_kb());
            Self {
                tab: Tab::Storage,
                targets: crate::storage::default_targets(&home)
                    .into_iter()
                    .map(|target| TargetRow {
                        target,
                        selected: false,
                    })
                    .collect(),
                mem,
                mem_history,
                procs: Vec::new(),
                log: VecDeque::from([JobLog {
                    level: LogLevel::Info,
                    text: "purge ready - press s to scan".into(),
                }]),
                cursor: 0,
                proc_cursor: 0,
                log_scroll: 0,
                scanning: false,
                scan_rx: None,
                cleaning: false,
                clean_rx: None,
                last_refresh: Instant::now(),
                sudo_ok: crate::sudo::have_sudo(),
                spinner: 0,
                applied: limits::load_state(),
                rules: limits::load_rules(),
                filter: String::new(),
                input: None,
                input_buf: String::new(),
                confirm_clean: false,
                help: false,
                by_cpu: false,
                prev_cpu: HashMap::new(),
            }
        }

        pub fn push_log(&mut self, level: LogLevel, text: String) {
            self.log.push_back(JobLog { level, text });
            if self.log.len() > 400 {
                self.log.pop_front();
            }
        }

        /// Called each frame; drains channels and refreshes metrics.
        pub fn refresh(&mut self) {
            self.spinner = (self.spinner + 1) % SPINNER.len();
            self.drain_scan();
            self.drain_clean();

            if self.last_refresh.elapsed() > Duration::from_millis(1500) {
                self.mem = MemInfo::read();
                if let Some(v) = self.mem_history.back() {
                    if *v != self.mem.used_kb() {
                        self.mem_history.push_back(self.mem.used_kb());
                    }
                } else {
                    self.mem_history.push_back(self.mem.used_kb());
                }
                while self.mem_history.len() > MEM_HISTORY {
                    self.mem_history.pop_front();
                }

                let mut ps = crate::procs::top_processes(200, self.by_cpu);
                crate::procs::sample_cpu(&mut ps, &mut self.prev_cpu, HZ);
                if self.by_cpu {
                    ps.sort_by(|a, b| {
                        b.cpu_pct
                            .partial_cmp(&a.cpu_pct)
                            .unwrap_or(std::cmp::Ordering::Equal)
                    });
                }
                if !self.filter.is_empty() {
                    let f = self.filter.to_lowercase();
                    ps.retain(|p| {
                        p.name.to_lowercase().contains(&f) || p.comm.to_lowercase().contains(&f)
                    });
                }
                ps.truncate(50);
                self.procs = ps;

                self.sudo_ok = crate::sudo::have_sudo();
                self.applied = limits::load_state();
                self.rules = limits::load_rules();
                self.last_refresh = Instant::now();
            }

            self.cursor = self.cursor.min(self.targets.len().saturating_sub(1));
            self.proc_cursor = self.proc_cursor.min(self.procs.len().saturating_sub(1));
        }

        fn drain_scan(&mut self) {
            let Some(rx) = &self.scan_rx else {
                return;
            };
            loop {
                match rx.try_recv() {
                    Ok((idx, size)) => {
                        if idx < self.targets.len() {
                            self.targets[idx].target.size = size;
                            self.targets[idx].target.state = ScanState::Done;
                        }
                    }
                    Err(TryRecvError::Empty) => break,
                    Err(TryRecvError::Disconnected) => {
                        self.scanning = false;
                        self.scan_rx = None;
                        self.sort_targets();
                        self.push_log(LogLevel::Ok, "scan complete".into());
                        break;
                    }
                }
            }
        }

        fn drain_clean(&mut self) {
            let mut msgs: Vec<CleanMsg> = Vec::new();
            let mut finished = false;
            let mut disconnected = false;
            if let Some(rx) = &self.clean_rx {
                loop {
                    match rx.try_recv() {
                        Ok(m) => msgs.push(m),
                        Err(TryRecvError::Empty) => break,
                        Err(TryRecvError::Disconnected) => {
                            disconnected = true;
                            break;
                        }
                    }
                }
            } else {
                return;
            }
            for m in msgs {
                match m {
                    CleanMsg::Log(level, text) => self.push_log(level, text),
                    CleanMsg::Done => finished = true,
                }
            }
            if finished || disconnected {
                self.cleaning = false;
                self.clean_rx = None;
                if finished {
                    self.push_log(LogLevel::Info, "clean finished - rescanning...".into());
                    self.start_scan();
                }
            }
        }

        /// Pinned tools first, then directories sorted by size (largest first).
        fn sort_targets(&mut self) {
            let (mut tools, mut dirs): (Vec<TargetRow>, Vec<TargetRow>) =
                self.targets.iter().cloned().partition(|r| !r.target.is_dir());
            dirs.sort_by(|a, b| b.target.size.unwrap_or(0).cmp(&a.target.size.unwrap_or(0)));
            tools.append(&mut dirs);
            self.targets = tools;
            self.cursor = 0;
        }

        pub fn start_scan(&mut self) {
            if self.scanning {
                self.push_log(LogLevel::Warn, "scan already running".into());
                return;
            }
            if self.cleaning {
                self.push_log(LogLevel::Warn, "clean still running".into());
                return;
            }
            self.push_log(LogLevel::Info, "scanning targets...".into());
            self.scanning = true;
            let rows: Vec<CleanTarget> = self.targets.iter().map(|r| r.target.clone()).collect();
            let (tx, rx) = mpsc::channel();
            self.scan_rx = Some(rx);
            std::thread::spawn(move || {
                for (i, t) in rows.iter().enumerate() {
                    let size = runner::scan_target(t);
                    let _ = tx.send((i, size));
                }
            });
        }

        /// Kick off the async clean of all selected targets (confirm first).
        pub fn request_clean(&mut self) {
            if self.cleaning || self.scanning {
                self.push_log(LogLevel::Warn, "busy - wait for the current job".into());
                return;
            }
            let to_clean: Vec<(String, CleanTarget)> = self
                .targets
                .iter()
                .filter(|r| r.selected)
                .map(|r| (r.target.name.clone(), r.target.clone()))
                .collect();
            if to_clean.is_empty() {
                self.push_log(LogLevel::Warn, "no targets selected (space to select)".into());
                return;
            }
            self.push_log(
                LogLevel::Info,
                format!("cleaning {} targets...", to_clean.len()),
            );
            self.cleaning = true;
            let (tx, rx) = mpsc::channel();
            self.clean_rx = Some(rx);
            std::thread::spawn(move || {
                for (name, target) in &to_clean {
                    match runner::clean_target(target) {
                        Ok((ok, msg)) => {
                            let level = if ok { LogLevel::Ok } else { LogLevel::Err };
                            let _ = tx.send(CleanMsg::Log(level, format!("[{}] {}", name, msg)));
                        }
                        Err(e) => {
                            let _ = tx.send(CleanMsg::Log(LogLevel::Err, format!("[{}] {}", name, e)));
                        }
                    }
                }
                let _ = tx.send(CleanMsg::Done);
            });
        }

        pub fn set_all(&mut self, val: bool) {
            for row in &mut self.targets {
                row.selected = val;
            }
        }

        pub fn drop_caches(&mut self) {
            match crate::sudo::run_sudo(&["sh", "-c", "sync; echo 3 > /proc/sys/vm/drop_caches"]) {
                Ok(status) if status.success() => self.push_log(LogLevel::Ok, "dropped page cache".into()),
                Ok(_) => self.push_log(LogLevel::Err, "drop caches failed".into()),
                Err(e) => self.push_log(LogLevel::Err, format!("drop caches: {}", e)),
            }
        }

        pub fn clear_swap(&mut self) {
            let steps = [(vec!["swapoff", "-a"], "swap off"), (vec!["swapon", "-a"], "swap on")];
            for (args, label) in steps {
                let mut cmd = std::process::Command::new("sudo");
                cmd.args(["-n"]);
                cmd.args(&args);
                match cmd.output() {
                    Ok(o) if o.status.success() => self.push_log(LogLevel::Ok, label.into()),
                    Ok(_) => self.push_log(LogLevel::Err, format!("{} failed", label)),
                    Err(e) => self.push_log(LogLevel::Err, format!("{}: {}", label, e)),
                }
            }
        }

        pub fn kill_proc(&mut self, force: bool) {
            let Some(p) = self.procs.get(self.proc_cursor) else {
                return;
            };
            let sig = if force { "KILL" } else { "TERM" };
            let name = p.name.clone();
            match std::process::Command::new("kill")
                .args([format!("-{}", sig).as_str(), &p.pid.to_string()])
                .status()
            {
                Ok(_) => self.push_log(LogLevel::Ok, format!("sent {} to {}", sig, name)),
                Err(e) => self.push_log(LogLevel::Err, format!("kill {}: {}", name, e)),
            }
        }

        // ---- Limiter actions ----

        fn limiter_apply(&mut self, lim: Limit) {
            let Some(p) = self.procs.get(self.proc_cursor).cloned() else {
                self.push_log(LogLevel::Warn, "no process selected".into());
                return;
            };
            match limits::apply(p.pid, &p.comm, &lim, &mut self.applied) {
                Ok(msg) => self.push_log(
                    LogLevel::Ok,
                    format!("{} [{}] applied {}", p.name, p.pid, msg),
                ),
                Err(e) => self.push_log(LogLevel::Err, format!("{}: {}", p.name, e)),
            }
        }

        fn limiter_restore(&mut self) {
            let Some(p) = self.procs.get(self.proc_cursor).cloned() else {
                self.push_log(LogLevel::Warn, "no process selected".into());
                return;
            };
            match limits::restore(p.pid, &mut self.applied) {
                Ok(msg) => self.push_log(LogLevel::Ok, format!("{} [{}] {}", p.name, p.pid, msg)),
                Err(e) => self.push_log(LogLevel::Warn, format!("{}: {}", p.name, e)),
            }
        }

        fn limiter_save_rule(&mut self) {
            let Some(p) = self.procs.get(self.proc_cursor).cloned() else {
                self.push_log(LogLevel::Warn, "no process selected".into());
                return;
            };
            let Some(a) = self.applied.iter().find(|a| a.pid == p.pid) else {
                self.push_log(
                    LogLevel::Warn,
                    "apply a limit first (c/m), then save it as a rule".into(),
                );
                return;
            };
            let lim = a.lim.clone();
            match limits::save_rule(&p.comm, &lim) {
                Ok(msg) => {
                    self.rules = limits::load_rules();
                    self.push_log(LogLevel::Ok, format!("{}: {}", msg, lim.display()));
                }
                Err(e) => self.push_log(LogLevel::Err, e),
            }
        }

        fn limiter_del_rule(&mut self) {
            let Some(p) = self.procs.get(self.proc_cursor).cloned() else {
                self.push_log(LogLevel::Warn, "no process selected".into());
                return;
            };
            match limits::delete_rule(&p.comm) {
                Ok(msg) => {
                    self.rules = limits::load_rules();
                    self.push_log(LogLevel::Ok, msg);
                }
                Err(e) => self.push_log(LogLevel::Warn, e),
            }
        }

        fn limiter_reapply(&mut self) {
            match limits::apply_rules(&mut self.applied) {
                Ok((n, notes)) => {
                    self.push_log(LogLevel::Ok, format!("applied {} limit(s)", n));
                    for note in notes {
                        self.push_log(LogLevel::Info, note);
                    }
                }
                Err(e) => self.push_log(LogLevel::Err, e),
            }
        }

        pub fn cycle_tab(&mut self, dir: i32) {
            let idx = TABS.iter().position(|t| *t == self.tab).unwrap_or(0) as i32;
            let n = TABS.len() as i32;
            let next = (idx + dir).rem_euclid(n) as usize;
            self.tab = TABS[next];
            self.cursor = 0;
            self.proc_cursor = 0;
            self.log_scroll = 0;
        }

        pub fn handle_key(&mut self, key: KeyCode) -> bool {
            if self.help {
                self.help = false;
                return false;
            }
            if self.input.is_some() {
                self.handle_input(key);
                return false;
            }
            if self.confirm_clean {
                match key {
                    KeyCode::Char('y') | KeyCode::Char('Y') | KeyCode::Enter => {
                        self.confirm_clean = false;
                        self.request_clean();
                    }
                    KeyCode::Char('n') | KeyCode::Char('N') | KeyCode::Esc => {
                        self.confirm_clean = false;
                        self.push_log(LogLevel::Info, "clean cancelled".into());
                    }
                    _ => {}
                }
                return false;
            }
            if key == KeyCode::Char('?') {
                self.help = true;
                return false;
            }
            match self.tab {
                Tab::Storage => self.handle_storage_key(key),
                Tab::Memory => self.handle_memory_key(key),
                Tab::Processes => self.handle_proc_key(key),
                Tab::Limiter => self.handle_limiter_key(key),
                Tab::Logs => self.handle_logs_key(key),
            }
        }

        fn handle_input(&mut self, key: KeyCode) {
            match key {
                KeyCode::Esc => {
                    self.input = None;
                    self.input_buf.clear();
                }
                KeyCode::Backspace => {
                    self.input_buf.pop();
                }
                KeyCode::Enter => {
                    let mode = self.input.take().unwrap_or(InputMode::Cpu);
                    let buf = std::mem::take(&mut self.input_buf);
                    match mode {
                        InputMode::Cpu => match buf.trim().parse::<u32>() {
                            Ok(v) if v >= 1 && v <= 100 => {
                                self.limiter_apply(Limit {
                                    cpu_pct: Some(v),
                                    mem_mb: None,
                                });
                            }
                            _ => self
                                .push_log(LogLevel::Err, "cpu limit must be 1-100".into()),
                        },
                        InputMode::Mem => match buf.trim().parse::<u64>() {
                            Ok(v) if v >= 1 => {
                                self.limiter_apply(Limit {
                                    cpu_pct: None,
                                    mem_mb: Some(v),
                                });
                            }
                            _ => self
                                .push_log(LogLevel::Err, "memory limit must be >= 1 MB".into()),
                        },
                        InputMode::Filter => {
                            self.filter = buf;
                            self.proc_cursor = 0;
                        }
                    }
                }
                KeyCode::Char(c) => self.input_buf.push(c),
                _ => {}
            }
        }

        fn open_input(&mut self, mode: InputMode) {
            self.input = Some(mode);
            self.input_buf = match mode {
                InputMode::Filter => self.filter.clone(),
                _ => String::new(),
            };
        }

        fn handle_storage_key(&mut self, key: KeyCode) -> bool {
            match key {
                KeyCode::Char('q') => true,
                KeyCode::Tab => {
                    self.cycle_tab(1);
                    false
                }
                KeyCode::BackTab => {
                    self.cycle_tab(-1);
                    false
                }
                KeyCode::Down | KeyCode::Char('j') => {
                    self.cursor = (self.cursor + 1).min(self.targets.len().saturating_sub(1));
                    false
                }
                KeyCode::Up | KeyCode::Char('k') => {
                    self.cursor = self.cursor.saturating_sub(1);
                    false
                }
                KeyCode::PageDown => {
                    self.cursor = (self.cursor + 10).min(self.targets.len().saturating_sub(1));
                    false
                }
                KeyCode::PageUp => {
                    self.cursor = self.cursor.saturating_sub(10);
                    false
                }
                KeyCode::Home => {
                    self.cursor = 0;
                    false
                }
                KeyCode::End => {
                    self.cursor = self.targets.len().saturating_sub(1);
                    false
                }
                KeyCode::Char(' ') => {
                    if let Some(row) = self.targets.get_mut(self.cursor) {
                        row.selected = !row.selected;
                    }
                    false
                }
                KeyCode::Char('s') => {
                    self.start_scan();
                    false
                }
                KeyCode::Char('c') => {
                    if self.targets.iter().any(|r| r.selected) {
                        self.confirm_clean = true;
                    } else {
                        self.push_log(LogLevel::Warn, "no targets selected (space to select)".into());
                    }
                    false
                }
                KeyCode::Char('a') => {
                    self.set_all(true);
                    false
                }
                KeyCode::Char('n') => {
                    self.set_all(false);
                    false
                }
                _ => false,
            }
        }

        fn handle_memory_key(&mut self, key: KeyCode) -> bool {
            match key {
                KeyCode::Char('q') => true,
                KeyCode::Tab => {
                    self.cycle_tab(1);
                    false
                }
                KeyCode::BackTab => {
                    self.cycle_tab(-1);
                    false
                }
                KeyCode::Char('d') => {
                    self.drop_caches();
                    false
                }
                KeyCode::Char('w') => {
                    self.clear_swap();
                    false
                }
                KeyCode::Char('r') => {
                    // sudo re-auth is handled by main loop w/ terminal suspend
                    false
                }
                _ => false,
            }
        }

        fn handle_proc_key(&mut self, key: KeyCode) -> bool {
            match key {
                KeyCode::Char('q') => true,
                KeyCode::Tab => {
                    self.cycle_tab(1);
                    false
                }
                KeyCode::BackTab => {
                    self.cycle_tab(-1);
                    false
                }
                KeyCode::Down | KeyCode::Char('j') => {
                    self.proc_cursor = (self.proc_cursor + 1).min(self.procs.len().saturating_sub(1));
                    false
                }
                KeyCode::Up | KeyCode::Char('k') => {
                    self.proc_cursor = self.proc_cursor.saturating_sub(1);
                    false
                }
                KeyCode::PageDown => {
                    self.proc_cursor = (self.proc_cursor + 10).min(self.procs.len().saturating_sub(1));
                    false
                }
                KeyCode::PageUp => {
                    self.proc_cursor = self.proc_cursor.saturating_sub(10);
                    false
                }
                KeyCode::Home => {
                    self.proc_cursor = 0;
                    false
                }
                KeyCode::End => {
                    self.proc_cursor = self.procs.len().saturating_sub(1);
                    false
                }
                KeyCode::Char('x') => {
                    self.kill_proc(false);
                    false
                }
                KeyCode::Char('X') => {
                    self.kill_proc(true);
                    false
                }
                KeyCode::Char('t') => {
                    self.by_cpu = !self.by_cpu;
                    self.push_log(
                        LogLevel::Info,
                        if self.by_cpu {
                            "sorting by CPU".into()
                        } else {
                            "sorting by RAM".into()
                        },
                    );
                    false
                }
                _ => false,
            }
        }

        fn handle_limiter_key(&mut self, key: KeyCode) -> bool {
            match key {
                KeyCode::Char('q') => true,
                KeyCode::Tab => {
                    self.cycle_tab(1);
                    false
                }
                KeyCode::BackTab => {
                    self.cycle_tab(-1);
                    false
                }
                KeyCode::Down | KeyCode::Char('j') => {
                    self.proc_cursor = (self.proc_cursor + 1).min(self.procs.len().saturating_sub(1));
                    false
                }
                KeyCode::Up | KeyCode::Char('k') => {
                    self.proc_cursor = self.proc_cursor.saturating_sub(1);
                    false
                }
                KeyCode::PageDown => {
                    self.proc_cursor = (self.proc_cursor + 10).min(self.procs.len().saturating_sub(1));
                    false
                }
                KeyCode::PageUp => {
                    self.proc_cursor = self.proc_cursor.saturating_sub(10);
                    false
                }
                KeyCode::Home => {
                    self.proc_cursor = 0;
                    false
                }
                KeyCode::End => {
                    self.proc_cursor = self.procs.len().saturating_sub(1);
                    false
                }
                KeyCode::Char('c') => {
                    self.open_input(InputMode::Cpu);
                    false
                }
                KeyCode::Char('m') => {
                    self.open_input(InputMode::Mem);
                    false
                }
                KeyCode::Char('x') => {
                    self.limiter_restore();
                    false
                }
                KeyCode::Char('s') => {
                    self.limiter_save_rule();
                    false
                }
                KeyCode::Char('d') => {
                    self.limiter_del_rule();
                    false
                }
                KeyCode::Char('A') => {
                    self.limiter_reapply();
                    false
                }
                KeyCode::Char('/') => {
                    self.open_input(InputMode::Filter);
                    false
                }
                KeyCode::Char('t') => {
                    self.by_cpu = !self.by_cpu;
                    false
                }
                _ => false,
            }
        }

        fn handle_logs_key(&mut self, key: KeyCode) -> bool {
            match key {
                KeyCode::Char('q') => true,
                KeyCode::Tab => {
                    self.cycle_tab(1);
                    false
                }
                KeyCode::BackTab => {
                    self.cycle_tab(-1);
                    false
                }
                KeyCode::Char('c') => {
                    self.log.clear();
                    self.log_scroll = 0;
                    false
                }
                KeyCode::Down | KeyCode::Char('j') => {
                    self.log_scroll = self.log_scroll.saturating_sub(1);
                    false
                }
                KeyCode::Up | KeyCode::Char('k') => {
                    self.log_scroll = self.log_scroll.saturating_add(1).min(self.log.len());
                    false
                }
                KeyCode::PageDown => {
                    self.log_scroll = self.log_scroll.saturating_sub(10);
                    false
                }
                KeyCode::PageUp => {
                    self.log_scroll = self.log_scroll.saturating_add(10).min(self.log.len());
                    false
                }
                KeyCode::Home => {
                    self.log_scroll = self.log.len();
                    false
                }
                KeyCode::End => {
                    self.log_scroll = 0;
                    false
                }
                _ => false,
            }
        }
    }

