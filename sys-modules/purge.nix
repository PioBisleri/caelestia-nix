    fn draw_storage(f: &mut Frame, app: &App, area: Rect) {
        let widths = [
            Constraint::Length(3),
            Constraint::Length(26),
            Constraint::Length(12),
            Constraint::Min(10),
        ];
        // account for block borders (2) + header row (1)
        let (top, bottom) = window(app.targets.len(), app.cursor, area.height.saturating_sub(3) as usize);

        let rows: Vec<Row> = app
            .targets
            .iter()
            .enumerate()
            .skip(top)
            .take(bottom.saturating_sub(top))
            .map(|(i, row)| {
                let t = &row.target;
                let mark = if row.selected { "[x]" } else { "[ ]" };
                let size = match (t.state, t.size) {
                    (ScanState::Scanning, _) => "…".to_string(),
                    (ScanState::Pending, _) => "-".to_string(),
                    (_, Some(sz)) => display_bytes(sz),
                    (_, None) => "?".to_string(),
                };
                let style = if i == app.cursor {
                    Style::default()
                        .bg(theme::SURFACE)
                        .add_modifier(Modifier::BOLD)
                } else {
                    Style::default()
                };
                let fg = if i == app.cursor {
                    theme::MAUVE
                } else if row.selected {
                    theme::GREEN
                } else {
                    theme::TEXT
                };
                Row::new(vec![
                    Cell::from(mark),
                    Cell::from(t.name).style(Style::default().fg(fg)),
                    Cell::from(size).style(Style::default().fg(theme::PEACH)),
                    Cell::from(t.desc).style(Style::default().fg(theme::SUBTLE)),
                ])
                .style(style)
            })
            .collect();

        let title = scroll_title("Storage", top, bottom, app.targets.len());
        let table = Table::new(rows, widths)
            .header(Row::new(vec![
                Cell::from("sel"),
                Cell::from("target"),
                Cell::from("size"),
                Cell::from("description"),
            ]))
            .block(Block::default().borders(Borders::ALL).title(title));
        f.render_widget(table, area);
    }

    /// Build a table title with a scroll position indicator when overflowing.
    fn scroll_title(base: &str, top: usize, bottom: usize, total: usize) -> String {
        if total <= bottom.saturating_sub(top) || total == 0 {
            base.to_string()
        } else {
            format!("{}  {}/{}", base, bottom, total)
        }
    }

    /// Compute the visible slice [top, bottom) for a list given the selected
    /// cursor, keeping `cursor` on-screen. `visible` is the max rows we can show.
    fn window(total: usize, cursor: usize, visible: usize) -> (usize, usize) {
        if total == 0 || visible == 0 {
            return (0, 0);
        }
        let cursor = cursor.min(total.saturating_sub(1));
        if total <= visible {
            return (0, total);
        }
        let top = cursor
            .saturating_sub(visible - 1)
            .min(total.saturating_sub(visible));
        (top, top + visible)
    }

    fn draw_memory(f: &mut Frame, app: &App, area: Rect) {
        let m = &app.mem;
        let inner = Layout::vertical([
            Constraint::Length(3),
            Constraint::Length(3),
            Constraint::Length(3),
            Constraint::Length(1),
            Constraint::Min(4),
        ])
        .split(area);

        let ram_ratio = m.ratio(m.used_kb());
        let swap_ratio = m.swap_ratio();
        let reclaim_ratio = m.ratio(m.reclaimable_kb());

        let ram_gauge = Gauge::default()
            .block(Block::default().borders(Borders::ALL).title("RAM"))
            .gauge_style(Style::default().fg(theme::MAUVE))
            .ratio(ram_ratio)
            .label(format!(
                "{} / {}  ({}%)",
                display_bytes(m.used_kb() * 1024),
                display_bytes(m.total_kb * 1024),
                (ram_ratio * 100.0) as u64
            ));
        let swap_gauge = Gauge::default()
            .block(Block::default().borders(Borders::ALL).title("Swap"))
            .gauge_style(Style::default().fg(theme::BLUE))
            .ratio(swap_ratio)
            .label(format!(
                "{} / {}",
                display_bytes(m.swap_used_kb() * 1024),
                display_bytes(m.swap_total_kb * 1024)
            ));
        let reclaim_gauge = Gauge::default()
            .block(Block::default().borders(Borders::ALL).title("Reclaimable (page cache)"))
            .gauge_style(Style::default().fg(theme::GREEN))
            .ratio(reclaim_ratio)
            .label(format!(
                "{}  ({}%)",
                display_bytes(m.reclaimable_kb() * 1024),
                (reclaim_ratio * 100.0) as u64
            ));

        f.render_widget(ram_gauge, inner[0]);
        f.render_widget(swap_gauge, inner[1]);
        f.render_widget(reclaim_gauge, inner[2]);

        let info = if app.sudo_ok {
            "sudo: cached ✓".to_string()
        } else {
            "sudo: not cached (press r to authenticate)".to_string()
        };
        f.render_widget(
            Paragraph::new(Line::from(Span::styled(info, theme::subtle()))),
            inner[3],
        );

        // buff/cache breakdown
        let detail = format!(
            "buffers {}   cached {}   slab_reclaimable {}",
            display_bytes(m.buffers_kb * 1024),
            display_bytes(m.cached_kb * 1024),
            display_bytes(m.sreclaimable_kb * 1024),
        );
        f.render_widget(
            Paragraph::new(Line::from(Span::styled(detail, theme::text())))
                .block(Block::default().borders(Borders::ALL).title("Detail")),
            inner[4],
        );
    }

    fn draw_processes(f: &mut Frame, app: &App, area: Rect) {
        let widths = [
            Constraint::Length(8),
            Constraint::Length(28),
            Constraint::Length(12),
            Constraint::Min(20),
        ];
        let (top, bottom) = window(app.procs.len(), app.proc_cursor, area.height.saturating_sub(3) as usize);

        let rows: Vec<Row> = app
            .procs
            .iter()
            .enumerate()
            .skip(top)
            .take(bottom.saturating_sub(top))
            .map(|(i, p)| {
                let style = if i == app.proc_cursor {
                    Style::default()
                        .bg(theme::SURFACE)
                        .add_modifier(Modifier::BOLD)
                } else {
                    Style::default()
                };
                let fg = if i == app.proc_cursor {
                    theme::RED
                } else {
                    theme::TEXT
                };
                Row::new(vec![
                    Cell::from(p.pid.to_string()).style(Style::default().fg(theme::SUBTLE)),
                    Cell::from(p.name.as_str()).style(Style::default().fg(fg)),
                    Cell::from(display_bytes(p.rss_kb * 1024)).style(Style::default().fg(theme::PEACH)),
                    Cell::from(p.cmd.as_str()).style(Style::default().fg(theme::SUBTLE)),
                ])
                .style(style)
            })
            .collect();

        let title = scroll_title("Top processes by RAM", top, bottom, app.procs.len());
        let table = Table::new(rows, widths)
            .header(Row::new(vec![
                Cell::from("pid"),
                Cell::from("name"),
                Cell::from("rss"),
                Cell::from("cmdline"),
            ]))
            .block(Block::default().borders(Borders::ALL).title(title));
        f.render_widget(table, area);
    }

    fn draw_logs(f: &mut Frame, app: &App, area: Rect) {
        let visible = area.height.saturating_sub(2) as usize;
        let total = app.log.len();

        // log_scroll = offset from the bottom (0 = latest visible). Slice accordingly.
        let scroll = app.log_scroll.min(total);
        let shown = visible.min(total - scroll);

        let start = if shown == 0 { total } else { total - scroll - shown };

        let lines: Vec<Line> = app
            .log
            .iter()
            .skip(start)
            .take(shown.max(1))
            .map(|entry| {
                let color = match entry.level {
                    LogLevel::Ok => theme::GREEN,
                    LogLevel::Err => theme::RED,
                    LogLevel::Warn => theme::YELLOW,
                    LogLevel::Info => theme::TEXT,
                };
                Line::from(Span::styled(entry.text.as_str(), Style::default().fg(color)))
            })
            .collect();
        let title = if scroll == 0 {
            "Log".to_string()
        } else {
            format!("Log  ({} above)", scroll)
        };
        f.render_widget(
            Paragraph::new(lines)
                .block(Block::default().borders(Borders::ALL).title(title))
                .style(theme::text()),
            area,
        );
    }

    pub fn draw(f: &mut Frame, app: &App) {
        f.render_widget(
            Block::default().style(Style::default().bg(theme::BG)),
            f.area(),
        );
        header(f, app);
    }
