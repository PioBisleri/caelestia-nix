    fn cpu_style(pct: f64) -> Style {
        if pct >= 80.0 {
            Style::default().fg(theme::RED)
        } else if pct >= 30.0 {
            Style::default().fg(theme::PEACH)
        } else {
            Style::default().fg(theme::SUBTLE)
        }
    }

    fn draw_processes(f: &mut Frame, app: &App, area: Rect) {
        let widths = [
            Constraint::Length(7),
            Constraint::Length(22),
            Constraint::Length(10),
            Constraint::Length(7),
            Constraint::Min(20),
        ];
        let (top, bottom) = window(app.procs.len(), app.proc_cursor, area.height.saturating_sub(3) as usize);

        let rows: Vec<Row> = app
            .procs
            .iter()
            .enumerate()
            .skip(top)
            .take(bottom.saturating_sub(top))
            .map(|(i, p)| {
                let style = if i == app.proc_cursor {
                    Style::default()
                        .bg(theme::SURFACE)
                        .add_modifier(Modifier::BOLD)
                } else {
                    Style::default()
                };
                let fg = if i == app.proc_cursor {
                    theme::RED
                } else {
                    theme::TEXT
                };
                Row::new(vec![
                    Cell::from(p.pid.to_string()).style(Style::default().fg(theme::SUBTLE)),
                    Cell::from(p.name.as_str()).style(Style::default().fg(fg)),
